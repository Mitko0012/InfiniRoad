      <OriginalItemSpec>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\staticwebassets\Textures\road_texture.png'))</OriginalItemSpec>
    </StaticWebAsset>
  </ItemGroup>
</Project>